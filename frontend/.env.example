VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Only needed in production (e.g. on Vercel/Netlify), where the frontend and
# backend are deployed to different domains. Leave unset for local dev - Vite
# proxies /api to the local backend instead (see vite.config.js).
VITE_API_BASE_URL=https://your-backend.onrender.com/api
